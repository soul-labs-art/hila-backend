POSTGRES_DB=hila
POSTGRES_USER=hila
POSTGRES_PASSWORD=hila_local_only
POSTGRES_PORT=5433
API_PORT=8080
WEB_PORT=5173

# Local development only. Compose binds these ports to 127.0.0.1.
# Use managed secrets and explicit network rules for shared or hosted environments.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/hila
SPRING_DATASOURCE_USERNAME=hila
SPRING_DATASOURCE_PASSWORD=hila_local_only

# Local-only encryption key. Replace with a strong secret before real data.
OUTBOX_ENCRYPTION_KEY=development-only-replace-before-real-data
WEB_ORIGIN=http://127.0.0.1:5173
STORAGE_PROVIDER=local
# To use a private Cloudflare R2 bucket, set provider=r2 and all values below.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
